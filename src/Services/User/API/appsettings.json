{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "constr": "Server = .; Database = LMSUserServiceDb; TrustServerCertificate = True;" },

  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "lms-user-service",
    "TopicPrefix": "lms.",
    "Topics": [
      "UserRegisteredIntegrationEvent",
      "UserProfileUpdatedIntegrationEvent",
      "UserDeactivatedIntegrationEvent",
      "UserDeletedIntegrationEvent"
    ]
  }
}
